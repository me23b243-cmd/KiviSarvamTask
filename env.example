# All variables below are OPTIONAL — Kivi runs entirely on local, self-hosted
# Hugging Face models. No API key of any kind is required.
# Copy this file to .env and uncomment/edit only what you want to override,
# or export these directly in your shell before running the app.

# Hugging Face model identifiers (defaults are set in config.py)
# KIVI_SMALL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# KIVI_BIG_MODEL=Qwen/Qwen2.5-3B-Instruct

# SQLite database file path (default: <project>/data/memory.db)
# KIVI_DB_PATH=./data/memory.db

# Max new tokens for sentence reconstruction (default: 300)
# KIVI_RECONSTRUCT_MAX_NEW_TOKENS=300
